/* ------------------------------
   VARIABILE TEMA
------------------------------ */
:root {
    --bg: #f5f5f5;
    --text: #222;
    --card-bg: rgba(255, 255, 255, 0.35);
    --shadow: 0 8px 25px rgba(0,0,0,0.15);
    --accent: #4a6cf7;
}

body.dark {
    --bg: #0f0f0f;
    --text: #fff;
    --card-bg: rgba(20, 20, 20, 0.45);
    --shadow: 0 8px 25px rgba(0,0,0,0.6);
    --accent: #6a8cff;
}

/* ------------------------------
   GLOBAL
------------------------------ */
body {
    margin: 0;
    padding: 0;
    background: var(--bg);
    color: var(--text);
    font-family: "Segoe UI", sans-serif;
    overflow-x: hidden;
}

/* ------------------------------
   FUNDAL ANIMAT
------------------------------ */
.background-animation {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: radial-gradient(circle at 20% 20%, #6a8cff33, transparent),
                radial-gradient(circle at 80% 80%, #4a6cf733, transparent);
    filter: blur(40px);
    z-index: -1;
    animation: moveBg 12s infinite alternate ease-in-out;
}

@keyframes moveBg {
    0% { transform: translate(0,0); }
    100% { transform: translate(-40px, 40px); }
}

/* ------------------------------
   HEADER
------------------------------ */
.header {
    display: flex;
    align-items: center;
    padding: 15px;
    background: var(--card-bg);
    backdrop-filter: blur(10px);
    box-shadow: var(--shadow);
    position: sticky;
    top: 0;
    z-index: 10;
}

.menu-btn {
    font-size: 1.6rem;
    margin-right: 15px;
    cursor: pointer;
}

.app-title {
    font-size: 1.4rem;
    font-weight: bold;
}

/* ------------------------------
   MENIU LATERAL
------------------------------ */
.side-menu {
    position: fixed;
    top: 0;
    left: -260px;
    width: 260px;
    height: 100%;
    background: var(--card-bg);
    backdrop-filter: blur(15px);
    box-shadow: var(--shadow);
    padding-top: 70px;
    transition: 0.35s ease;
    z-index: 20;
}

.side-menu.open {
    left: 0;
}

.side-menu a {
    display: block;
    padding: 18px;
    font-size: 1.1rem;
    color: var(--text);
    text-decoration: none;
}

.side-menu a i {
    margin-right: 10px;
}

/* ------------------------------
   CARDURI 3D
------------------------------ */
.container {
    padding: 20px;
}

.card3d {
    background: var(--card-bg);
    backdrop-filter: blur(12px);
    padding: 25px;
    border-radius: 18px;
    margin-bottom: 20px;
    box-shadow: var(--shadow);
    transition: transform 0.25s ease, box-shadow 0.25s ease;
    cursor: pointer;
    text-align: center;
}

.card3d:hover {
    transform: translateY(-6px) scale(1.02);
    box-shadow: 0 12px 35px rgba(0,0,0,0.25);
}

.card3d i {
    font-size: 2.4rem;
    margin-bottom: 10px;
    color: var(--accent);
}

.card3d h2 {
    margin: 5px 0;
}

.card3d p {
    opacity: 0.8;
}

/* ------------------------------
   MENIU JOS
------------------------------ */
.bottom-nav {
    position: fixed;
    bottom: 0;
    left: 0;
    width: 100%;
    background: var(--card-bg);
    backdrop-filter: blur(10px);
    display: flex;
    justify-content: space-around;
    padding: 10px 0;
    box-shadow: var(--shadow);
}

.bottom-nav a {
    color: var(--text);
    text-decoration: none;
    text-align: center;
    font-size: 0.9rem;
}

.bottom-nav a i {
    font-size: 1.4rem;
}

.bottom-nav .active {
    color: var(--accent);
}

/* ------------------------------
   BUTON TTS PLUTITOR
------------------------------ */
.floating-tts {
    position: fixed;
    bottom: 80px;
    right: 20px;
    background: var(--accent);
    color: white;
    border: none;
    padding: 18px;
    border-radius: 50%;
    font-size: 1.4rem;
    box-shadow: var(--shadow);
    cursor: pointer;
    transition: 0.25s ease;
}

.floating-tts:hover {
    transform: scale(1.1);
}

/* ------------------------------
   ANIMAȚII SCROLL
------------------------------ */
.scroll-appear {
    opacity: 0;
    transform: translateY(20px);
    transition: 0.5s ease;
}

.scroll-appear.visible {
    opacity: 1;
    transform: translateY(0);
}

/* ------------------------------
   RESPONSIVE
------------------------------ */
@media (min-width: 700px) {
    .card3d {
        max-width: 500px;
        margin: 20px auto;
    }
}
